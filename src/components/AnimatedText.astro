---
interface Props {
  text: string
  class?: string
}

const { text, class: className = '' } = Astro.props
const chars = text.split('')
---

<span class={`animated-text ${className}`} aria-label={text}>
  {chars.map((char, i) => (
    <span
      class="char"
      aria-hidden="true"
      style={`animation-delay: ${i * 60}ms`}
    >{char === ' ' ? ' ' : char}</span>
  ))}
</span>

<style>
  .animated-text {
    display: inline-block;
  }

  .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(16px);
    animation: char-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes char-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .char {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
