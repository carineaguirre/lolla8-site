---
export const prerender = true

import Layout from '@/layouts/Layout.astro'

const APP_URL = 'https://app.lolla8.com'
const REGISTER_URL = `${APP_URL}/register`
const LOGIN_URL = `${APP_URL}/login`
const SUPPORT_EMAIL = import.meta.env.PUBLIC_SUPPORT_EMAIL ?? ''
const SUPPORT_WHATSAPP = (import.meta.env.PUBLIC_SUPPORT_WHATSAPP ?? '').replace(/\D/g, '')

const CTA = 'Começar meus 7 dias grátis'
const MICRO = 'Sem cartão de crédito · Cancele quando quiser · Pronto em 2 minutos'

const segments = [
  'Sabonetes', 'Velas', 'Joias e bijuterias', 'Cosméticos naturais',
  'Doces e alimentos', 'Bonecas', 'Papelaria', 'Moda e costura',
]

const pains = [
  'Anota pedidos no caderno, no bloco de notas e no direct — e sempre perde algum.',
  'Define o preço “no olho” e no fim do mês não sabe se teve lucro.',
  'Descobre que a matéria-prima acabou bem na hora de produzir.',
  'Manda foto de produto, uma por uma, para cada cliente que pergunta.',
  'Esquece quem comprou fiado, quando vence e quanto falta receber.',
  'A cliente comprou uma vez e nunca mais voltou — e você nem percebeu.',
]

const turn = [
  { t: 'Organize', d: 'Materiais, receitas, produtos, lotes e vendas conversando entre si.' },
  { t: 'Venda mais', d: 'Vitrine online, cupons e QR Codes que trazem clientes novas.' },
  { t: 'Fidelize', d: 'Saiba quem comprou, quando vai precisar de novo, e fale com ela no WhatsApp.' },
]

const vitrine = [
  ['Com a sua identidade', 'logo, cores, fonte, banners para computador e celular, tema claro ou escuro.'],
  ['Catálogo organizado', 'você escolhe quais produtos aparecem e em que ordem; categorias, busca e até 5 fotos por produto em carrossel.'],
  ['Carrinho completo', 'a cliente adiciona produtos e kits, ajusta quantidades e aplica cupom de desconto na hora.'],
  ['Pedido direto no seu WhatsApp', 'itens, desconto, total e dados da cliente chegam numa mensagem organizada.'],
  ['Passa confiança', 'selos de parcelamento, envio e atendimento, barra de promoção (“Frete grátis acima de R$150”), horários, formas de pagamento e CNPJ no rodapé.'],
  ['Link bonito para compartilhar', 'prévia com imagem quando enviado no WhatsApp e nas redes sociais.'],
  ['Pré-visualização ao vivo', 'no computador e no celular enquanto você edita.'],
]

const whatsapp = [
  ['Seu número, sua conversa', 'as clientes recebem mensagens de quem elas já conhecem — você.'],
  ['Campanhas para o público certo', 'todas as clientes, quem não compra há 30, 60, 90 ou 180 dias, quem nunca comprou ou clientes de uma cidade.'],
  ['Saiba antes de enviar', 'quantas pessoas vão receber.'],
  ['Envio cuidadoso', 'cada cliente recebe a mesma campanha uma única vez, com intervalo entre os envios e registro do que foi entregue.'],
  ['Mensagens prontas em 1 clique', 'parabéns de aniversário, lembrete gentil de parcela do fiado, agradecimento pela compra, envio do catálogo e convite para recompra.'],
]

const cupons = [
  ['Do seu jeito', 'desconto em % ou em R$, código personalizado ou gerado automaticamente.'],
  ['Regras inteligentes', 'produtos específicos ou loja toda, período de validade, dias da semana, valor mínimo do pedido, limite total e limite por cliente.'],
  ['Funciona em todo lugar', 'na vitrine online e no balcão (na tela de Nova Venda), com validação automática.'],
  ['Envio pelo WhatsApp', 'para uma cliente ou para um grupo inteiro.'],
  ['Resultado na tela', 'clientes notificadas, cupons usados e taxa de conversão de cada campanha.'],
  ['Controle total', 'pause, retome ou edite quando quiser.'],
]

const qr = [
  ['Pensado para cada lugar', 'feira ou evento, loja física, Instagram, embalagem, cartão de visita.'],
  ['Você escolhe o que perguntar', 'WhatsApp, e-mail, cidade, aniversário, Instagram e aceite para receber promoções.'],
  ['Mensagem personalizada', 'com o nome da cliente e o código do cupom.'],
  ['Funil completo', 'quantas pessoas escanearam → deixaram contato → receberam o cupom → compraram.'],
  ['Conheça seu público', 'as cidades que mais escanearam e o tipo de celular.'],
  ['Baixe o QR em imagem', 'e imprima onde quiser.'],
]

const clientes = [
  ['Ficha completa', 'contato, Instagram, endereço, aniversário e datas especiais (ex.: aniversário de casamento).'],
  ['Histórico de compras', 'total gasto e ticket médio de cada cliente.'],
  ['Inteligência de recompra', 'o lolla8 calcula de quanto em quanto tempo a cliente compra, prevê a próxima compra e avisa quando ela está atrasada — com uma mensagem pronta citando o último produto que ela levou.'],
  ['Sininho de lembretes', 'aniversários e datas especiais da semana, e parcelas do fiado vencidas, com mensagem pronta para enviar.'],
  ['Sugestões', 'de produtos que ela ainda não experimentou.'],
]

const gestao = [
  {
    t: 'Preço certo, lucro de verdade',
    items: [
      'Custo real de cada peça: materiais, mão de obra e custos indiretos.',
      'Preço sugerido pela margem ou preço manual, com lucro por unidade e por lote.',
      'Margem média dos produtos sempre à vista.',
    ],
    quote: 'Nunca mais venda no prejuízo sem saber.',
  },
  {
    t: 'Matérias-primas e fornecedores',
    items: [
      'Estoque atualizado a cada compra e a cada produção, com custo médio automático.',
      'Alerta de estoque baixo e de material vencendo.',
      'Histórico de compras, evolução de custo e comparação de preço por fornecedor.',
      'Pedido de compra com vários materiais de uma vez.',
    ],
  },
  {
    t: 'Receitas e produção',
    items: [
      'Receitas com ingredientes, perdas, passo a passo, dicas e tempo.',
      'Calculadora de escala: quer fazer o dobro? O lolla8 recalcula tudo.',
      'Produza a partir da receita: o sistema confere o estoque, dá baixa nos materiais e gera o lote.',
      'Lotes numerados com data de fabricação e validade.',
    ],
  },
  {
    t: 'Produtos e kits',
    items: [
      'Produtos feitos por receita, feitos à mão ou de revenda.',
      'Kits e combos, montados antes ou na hora da venda, com baixa de cada item.',
      'Até 5 fotos por produto, otimizadas automaticamente.',
    ],
  },
  {
    t: 'Vendas e fiado sem dor de cabeça',
    items: [
      'Nova venda em segundos: produtos, kits, descontos e cupons.',
      'Dinheiro, Pix, cartão ou fiado parcelado, com vencimentos e juros.',
      'Lucro bruto de cada venda calculado automaticamente.',
    ],
  },
  {
    t: 'Painel do seu negócio',
    items: [
      'Faturamento, lucro bruto, margem, pedidos e ticket médio — hoje, na semana, no mês e no ano, comparados com o período anterior.',
      'Gráfico de faturamento e produtos mais vendidos.',
      'Central de alertas: lotes vencendo, material em falta, fiado atrasado.',
    ],
  },
  {
    t: 'Equipamentos',
    items: ['Cadastro com garantia, manutenções, anexos (notas e manuais) e custos.'],
  },
]

const steps = [
  ['Crie sua conta em 2 minutos', 'só e-mail e senha. Sem cartão.'],
  ['Cadastre seus produtos e monte sua vitrine', 'escolha cores, logo e o que vai aparecer.'],
  ['Venda, acompanhe e fidelize', 'e veja seu ateliê ganhar outro nível.'],
]

const forWho = [
  'Você vende o que produz e quer saber seu lucro de verdade.',
  'Vende pelo Instagram, WhatsApp, feiras ou encomendas.',
  'Quer parecer (e ser) uma marca profissional.',
  'Está cansada de planilha que ninguém atualiza.',
  'Quer que a cliente volte a comprar.',
]

const faq = [
  ['Preciso de cartão para testar?', 'Não. Você testa 7 dias grátis só com e-mail e senha.'],
  ['O que acontece depois dos 7 dias?', 'Para continuar usando, é só assinar por R$ 47/mês no cartão. Se não assinar, nada é cobrado.'],
  ['Posso cancelar quando quiser?', 'Sim, sem multa. Você continua com acesso até o fim do período já pago.'],
  ['O WhatsApp funciona no teste grátis?', 'A conexão do WhatsApp é liberada ao assinar. Durante o teste você usa todo o resto: vitrine, cupons, QR Codes, clientes, estoque, custos e vendas.'],
  ['Vou usar meu próprio número de WhatsApp?', 'Sim. Você conecta seu número lendo um QR Code, e as mensagens saem dele.'],
  ['A vitrine cobra comissão?', 'Não. Os pedidos chegam no seu WhatsApp e você combina pagamento e entrega direto com a cliente.'],
  ['Funciona no celular?', 'Sim: no celular, no tablet e no computador, direto no navegador.'],
  ['Não entendo de tecnologia. Vou conseguir?', 'O lolla8 foi feito para artesãs, com passo a passo em cada cadastro. Em minutos sua vitrine está no ar.'],
  ['Meus dados ficam seguros?', 'Sim. Ficam na nuvem, protegidos e separados de qualquer outro negócio.'],
  ['Funciona para o meu tipo de artesanato?', 'Se você produz e vende — sabonetes, velas, joias, cosméticos, doces, bonecas, papelaria, moda — o lolla8 é para você.'],
  ['E se eu precisar de ajuda?', 'Fale com o nosso suporte pelo WhatsApp ou por e-mail.'],
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
}
---

<Layout
  title="lolla8 — Seu ateliê merece ser tratado como negócio"
  description="Custo real de cada peça, estoque, vendas, vitrine online, cupons e WhatsApp em um só lugar. Teste o lolla8 por 7 dias grátis, sem cartão de crédito."
  canonical="https://lp.lolla8.com/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- 1. Barra de anúncio -->
  <a class="announce" href={REGISTER_URL}>
    <strong>7 dias grátis para testar tudo, sem cadastrar cartão.</strong>
    <span>Começar agora →</span>
  </a>

  <header class="site-header" id="top">
    <div class="wrap header-inner">
      <a href="#top" class="logo" aria-label="lolla8 — início">
        <svg viewBox="0 0 100 100" width="28" height="28" aria-hidden="true">
          <rect width="100" height="100" rx="22" fill="#0C1B23" />
          <circle cx="50" cy="65" r="18" fill="none" stroke="#4E7A5B" stroke-width="10" />
          <circle cx="50" cy="35" r="18" fill="none" stroke="#CC6A3C" stroke-width="10" />
        </svg>
        <span>lolla8</span>
      </a>
      <nav class="header-nav" aria-label="Seções">
        <a href="#vitrine">Vitrine</a>
        <a href="#whatsapp">WhatsApp</a>
        <a href="#gestao">Gestão</a>
        <a href="#preco">Preço</a>
        <a href="#faq">Dúvidas</a>
      </nav>
      <div class="header-actions">
        <a href={LOGIN_URL} class="link-quiet">Entrar</a>
        <a href={REGISTER_URL} class="btn btn-sm">Testar grátis</a>
      </div>
    </div>
  </header>

  <main>
    <!-- 2. Hero -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Para quem cria com as mãos</p>
          <h1>Seu ateliê merece ser tratado como <em>negócio.</em></h1>
          <p class="lead">
            Calcule o custo real de cada peça, controle estoque e vendas, tenha sua própria vitrine online e traga clientes de volta com cupons e mensagens no WhatsApp. O lolla8 foi feito para quem cria com as mãos.
          </p>
          <div class="cta-block">
            <a href={REGISTER_URL} class="btn btn-lg">{CTA}</a>
            <p class="micro">Sem cartão de crédito · Sem compromisso · Funciona no celular e no computador</p>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="mock-laptop">
            <div class="mock-bar"><i></i><i></i><i></i></div>
            <div class="mock-dash">
              <div class="dash-side">
                <b></b><b class="on"></b><b></b><b></b><b></b>
              </div>
              <div class="dash-main">
                <p class="dash-title">Painel · Este mês</p>
                <div class="kpis">
                  <div><small>Faturamento</small><strong>R$ 8.420</strong><em>+18%</em></div>
                  <div><small>Lucro bruto</small><strong>R$ 4.910</strong><em>+22%</em></div>
                  <div><small>Ticket médio</small><strong>R$ 86</strong><em>+6%</em></div>
                </div>
                <div class="bars">
                  {[38, 52, 44, 61, 58, 72, 66, 80, 74, 92, 85, 100].map(h => <span style={`height:${h}%`}></span>)}
                </div>
              </div>
            </div>
          </div>
          <div class="mock-phone hero-phone">
            <div class="ph-notch"></div>
            <div class="ph-store">
              <div class="ph-banner">Ateliê Flor de Sal</div>
              <div class="ph-promo">Frete grátis acima de R$150</div>
              <div class="ph-grid">
                <div><span class="ph-img c1"></span><small>Sabonete lavanda</small><b>R$ 24</b></div>
                <div><span class="ph-img c2"></span><small>Vela de soja</small><b>R$ 49</b></div>
                <div><span class="ph-img c3"></span><small>Kit presente</small><b>R$ 89</b></div>
                <div><span class="ph-img c4"></span><small>Óleo corporal</small><b>R$ 39</b></div>
              </div>
            </div>
          </div>
          <div class="wa-bubble hero-bubble">
            <span class="wa-dot"></span>
            <div>
              <p>Oi, Ana! Sentimos sua falta 💜 Use o cupom <b>VOLTA10</b> e ganhe 10% OFF.</p>
              <small>14:32 ✓✓</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Faixa de segmentos -->
    <section class="segments" aria-label="Segmentos atendidos">
      <div class="wrap">
        <p>Feito para quem produz</p>
        <ul>
          {segments.map(s => <li>{s}</li>)}
          <li class="more">e muito mais</li>
        </ul>
      </div>
    </section>

    <!-- 4. Dor -->
    <section class="section pain">
      <div class="wrap narrow">
        <p class="eyebrow">Você se reconhece?</p>
        <h2>Você é ótima no que cria. Mas a parte do negócio está te cansando?</h2>
        <ul class="pain-list">
          {pains.map(p => <li class="reveal">{p}</li>)}
        </ul>
        <p class="pain-close reveal">
          Não é falta de talento. <strong>É falta de uma ferramenta feita para o seu jeito de trabalhar.</strong>
        </p>
      </div>
    </section>

    <!-- 5. Virada -->
    <section class="section turn">
      <div class="wrap">
        <p class="eyebrow center">Com o lolla8</p>
        <h2 class="center">Organização, gestão e profissionalismo — finalmente no mesmo lugar.</h2>
        <div class="turn-grid">
          {turn.map((c, i) => (
            <article class="turn-card reveal">
              <span class="turn-num">0{i + 1}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Vitrine -->
    <section class="section feature" id="vitrine">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow">Vitrine</p>
          <h2>Sua loja online, com a sua cara. Pronta em minutos.</h2>
          <p class="lead">
            Chega de mandar foto por foto. Com a vitrine do lolla8 você tem um link profissional para colocar na bio do Instagram, no status e nos grupos. A cliente escolhe, monta o carrinho e o pedido chega pronto no seu WhatsApp.
          </p>
          <ul class="checks">
            {vitrine.map(([b, t]) => <li><strong>{b}:</strong> {t}</li>)}
          </ul>
          <p class="punch">Seu produto é lindo. Sua loja também precisa ser.</p>
          <a href={REGISTER_URL} class="btn">Quero minha vitrine</a>
        </div>

        <div class="flow" aria-hidden="true">
          <div class="mock-phone small">
            <div class="ph-notch"></div>
            <div class="ph-store">
              <div class="ph-banner">Vitrine</div>
              <div class="ph-grid one">
                <div><span class="ph-img c2 tall"></span><small>Vela de soja · 180g</small><b>R$ 49</b></div>
              </div>
              <div class="ph-btn">Adicionar ao carrinho</div>
            </div>
          </div>
          <span class="flow-arrow">→</span>
          <div class="mock-phone small">
            <div class="ph-notch"></div>
            <div class="ph-store">
              <div class="ph-banner">Carrinho</div>
              <div class="cart-line"><span>Vela de soja</span><b>2× R$ 49</b></div>
              <div class="cart-line"><span>Kit presente</span><b>1× R$ 89</b></div>
              <div class="cart-line coupon"><span>Cupom VOLTA10</span><b>− R$ 18,70</b></div>
              <div class="cart-line total"><span>Total</span><b>R$ 168,30</b></div>
              <div class="ph-btn wa">Enviar pedido no WhatsApp</div>
            </div>
          </div>
          <span class="flow-arrow">→</span>
          <div class="mock-phone small wa-screen">
            <div class="ph-notch"></div>
            <div class="wa-chat">
              <div class="wa-head">Novo pedido</div>
              <div class="wa-msg">
                <b>Pedido · Vitrine</b><br />
                2× Vela de soja<br />
                1× Kit presente<br />
                Cupom: VOLTA10<br />
                <b>Total: R$ 168,30</b><br />
                Cliente: Ana Souza
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. WhatsApp -->
    <section class="section feature alt" id="whatsapp">
      <div class="wrap feature-grid reverse">
        <div class="feature-copy">
          <p class="eyebrow">WhatsApp integrado</p>
          <h2>O WhatsApp que você já usa, agora trabalhando a seu favor.</h2>
          <p class="lead">
            Conecte o seu próprio número lendo um QR Code, igual ao WhatsApp Web. A partir daí, o lolla8 envia cupons e campanhas para suas clientes, do seu número, sem você copiar e colar nada.
          </p>
          <ul class="checks">
            {whatsapp.map(([b, t]) => <li><strong>{b}:</strong> {t}</li>)}
          </ul>
          <p class="note">A conexão do WhatsApp é liberada ao assinar. No teste grátis você já explora todo o resto do lolla8.</p>
        </div>

        <div class="panel campaign" aria-hidden="true">
          <p class="panel-title">Nova campanha</p>
          <label>Quem vai receber</label>
          <div class="chips">
            <span>Todas</span><span class="on">Sem comprar há 60 dias</span><span>Nunca compraram</span><span>Por cidade</span>
          </div>
          <div class="reach"><strong>47</strong> clientes vão receber esta mensagem</div>
          <label>Mensagem</label>
          <div class="msg-preview">Oi, {'{nome}'}! Faz tempo que você não passa por aqui 💜 Use o cupom <b>VOLTA10</b> e ganhe 10% OFF.</div>
          <div class="ready">
            <span>🎂 Aniversário</span><span>💳 Parcela do fiado</span><span>🙏 Obrigada</span><span>📖 Catálogo</span><span>🔁 Recompra</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Cupons -->
    <section class="section feature" id="cupons">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow">Cupons</p>
          <h2>Cupons que trazem a cliente de volta — e você vê o resultado.</h2>
          <p class="lead">
            Crie cupons em 5 passos e acompanhe quantas vezes foram usados, quanto de desconto você deu e quantas clientes voltaram a comprar.
          </p>
          <ul class="checks">
            {cupons.map(([b, t]) => <li><strong>{b}:</strong> {t}</li>)}
          </ul>
        </div>

        <div class="coupon-example">
          <p class="ex-label">Exemplo</p>
          <div class="ticket">
            <span class="ticket-code">VOLTA10</span>
            <strong>“Volta, sumida! 10% OFF”</strong>
          </div>
          <ol class="ex-steps">
            <li>Enviado para quem não compra há 60 dias</li>
            <li>A cliente usa na vitrine ou no balcão</li>
            <li>Você acompanha quem voltou</li>
          </ol>
          <div class="ex-stats" aria-label="Números ilustrativos">
            <div><strong>47</strong><small>notificadas</small></div>
            <div><strong>12</strong><small>cupons usados</small></div>
            <div><strong>25%</strong><small>conversão</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. QR Codes -->
    <section class="section feature alt" id="qrcodes">
      <div class="wrap feature-grid reverse">
        <div class="feature-copy">
          <p class="eyebrow">QR Codes</p>
          <h2>Cada pessoa que passa pela sua banca pode virar cliente.</h2>
          <p class="lead">
            Crie um QR Code com um cupom de boas-vindas e coloque na banca da feira, na embalagem, no cartão de visita ou no balcão. A pessoa aponta a câmera, preenche os dados e recebe o cupom na hora — na tela e no WhatsApp. Você fica com o contato dela.
          </p>
          <ul class="checks">
            {qr.map(([b, t]) => <li><strong>{b}:</strong> {t}</li>)}
          </ul>
          <p class="punch">A feira acaba no domingo. Os contatos ficam com você.</p>
          <a href={REGISTER_URL} class="btn">{CTA}</a>
        </div>

        <div class="qr-visual" aria-hidden="true">
          <div class="tag">
            <svg viewBox="0 0 21 21" class="qr" shape-rendering="crispEdges">
