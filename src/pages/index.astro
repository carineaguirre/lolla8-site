---
import Layout from '@/layouts/Layout.astro'
import AnimatedText from '@/components/AnimatedText.astro'
---

<Layout>
  <main>
    <div class="grid-bg" aria-hidden="true"></div>

    <header class="top-bar">
      <span class="logo">lolla8</span>
    </header>

    <section class="hero">
      <p class="eyebrow">Em breve</p>

      <h1>
        <AnimatedText text="Para quem faz" />
        <br />
        <AnimatedText text="com as mãos." class="accent-line" />
      </h1>

      <p class="subtitle">
        Gerencie seu ateliê, clientes e pedidos —<br />tudo em um só lugar.
      </p>

      <form class="notify-form" action="#" method="post" novalidate>
        <label for="email" class="visually-hidden">Seu e-mail</label>
        <input
          id="email"
          type="email"
          name="email"
          placeholder="seu@email.com"
          autocomplete="email"
          required
        />
        <button type="submit">Avise-me</button>
      </form>

      <p class="disclaimer">Sem spam. Só quando estiver pronto.</p>
    </section>

    <footer class="bottom-bar">
      <span>© 2026 lolla8</span>
    </footer>
  </main>
</Layout>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0d0d0d;
    --surface: #161616;
    --border: rgba(255,255,255,0.07);
    --text: #f0ece4;
    --muted: rgba(240,236,228,0.45);
    --accent: #d4a259;
    --accent-dim: rgba(212,162,89,0.15);
    --font: 'Inter', system-ui, -apple-system, sans-serif;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #faf9f7;
      --surface: #f2ede6;
      --border: rgba(0,0,0,0.07);
      --text: #1a1714;
      --muted: rgba(26,23,20,0.5);
      --accent: #b8852a;
      --accent-dim: rgba(184,133,42,0.12);
    }
  }

  html, body { height: 100%; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* subtle dot grid background */
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--border) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
  }

  /* radial fade over grid near center */
  .grid-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, transparent 30%, var(--bg) 100%);
  }

  /* top bar */
  .top-bar {
    position: relative;
    z-index: 1;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* hero */
  .hero {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem 4rem;
    gap: 1.25rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0;
    animation: fade-in 0.6s ease 0.1s forwards;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
    color: var(--text);
  }

  :global(.accent-line) {
    color: var(--accent);
  }

  .subtitle {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--muted);
    line-height: 1.6;
    text-wrap: balance;
    max-width: 36ch;
    opacity: 0;
    animation: fade-in 0.7s ease 0.8s forwards;
  }

  /* notify form */
  .notify-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.25rem;
    opacity: 0;
    animation: fade-in 0.7s ease 1s forwards;
  }

  .notify-form input {
    height: 2.75rem;
    padding: 0 1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    font-family: var(--font);
    width: clamp(220px, 40vw, 280px);
    outline: none;
    transition: border-color 0.2s;
  }

  .notify-form input::placeholder {
    color: var(--muted);
  }

  .notify-form input:focus {
    border-color: var(--accent);
  }

  .notify-form button {
    height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: #0d0d0d;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font);
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .notify-form button:hover {
    opacity: 0.85;
  }

  .disclaimer {
    font-size: 0.75rem;
    color: var(--muted);
    opacity: 0;
    animation: fade-in 0.7s ease 1.1s forwards;
  }

  /* bottom bar */
  .bottom-bar {
    position: relative;
    z-index: 1;
    padding: 1.25rem 2rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes fade-in {
    to { opacity: 1; }
  }
</style>
